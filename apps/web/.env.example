# Server-side Core API base URL. Do not expose engine endpoints to the browser.
PLATFORM_API_BASE_URL=http://localhost:8080

# Workspace demonstrated by the POC console. The UI never asks operators to paste object UUIDs.
POC_WORKSPACE_ID=

# Read-only by default. This flag is NOT authentication or authorization.
# Enable only on a trusted local/private POC deployment; see docs/poc/entity-review-ui.md.
POC_ENABLE_REVIEW_ACTIONS=false
# Real operator UUID for the isolated POC, derived on the server, never from browser input.
POC_REVIEWER_ID=
