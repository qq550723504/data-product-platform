# Server-side Core API base URL. Do not expose engine endpoints to the browser.
PLATFORM_API_BASE_URL=http://localhost:8080

# Workspace demonstrated by the POC console. The UI never asks operators to paste object UUIDs.
POC_WORKSPACE_ID=

# Entity Review writes are off by default.
POC_ENABLE_REVIEW_ACTIONS=false
# Server-only credential forwarded to Core's HUMAN_DECISION principal resolver.
# The browser never supplies reviewer/actor identity.
HUMAN_DECISION_API_TOKEN=

# ProductRelease publish writes are also off by default; see docs/poc/product-release-ui.md.
POC_ENABLE_RELEASE_ACTIONS=false
# Real publisher UUID for the isolated POC. Browser input is never accepted as actor identity.
POC_RELEASE_ACTOR_ID=

# CSV ingestion / entity-job creation; trusted POC only, NOT authentication.
POC_ENABLE_INGEST_ACTIONS=false
POC_INGEST_ACTOR_ID=
