# Server-side Core API base URL. Do not expose engine endpoints to the browser.
PLATFORM_API_BASE_URL=http://localhost:8080

# Workspace demonstrated by the POC console. The UI never asks operators to paste object UUIDs.
POC_WORKSPACE_ID=

# Operator identity used by audited POC actions such as entity review and ProductRelease publishing.
# Keep this server-side; it is sent to Core as X-Actor-ID and is never editable in the browser.
POC_ACTOR_ID=
