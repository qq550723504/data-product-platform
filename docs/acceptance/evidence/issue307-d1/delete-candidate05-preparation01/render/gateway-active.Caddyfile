{
 admin off
 auto_https off
}
:9000 {
 route {
  @bypass header X-Amz-Bypass-Governance-Retention *
  respond @bypass 403
  @copy header X-Amz-Copy-Source *
  respond @copy 403
  @unsigned header X-Amz-Content-Sha256 STREAMING-UNSIGNED-PAYLOAD-TRAILER
  respond @unsigned 403
  @approvedDelete {
   method DELETE
   expression {http.request.header.Authorization}.contains('Credential=refdelete9ea8f3e2/') && ({http.request.uri} == '/dpp-lifecycle307-online/fixture/a.csv?versionId=312365a9-f984-43de-b9d5-7e26009ccd82' || {http.request.uri} == '/dpp-lifecycle307-quarantine/fixture/b.csv?versionId=846d0c7c-289d-4667-bc7c-aa04e44357d4')
  }
  reverse_proxy @approvedDelete dpp-lifecycle307-5d2274ee-minio:9000 {
   @accepted status 204
   handle_response @accepted {
    abort
   }
  }
  @mutate method DELETE PUT POST PATCH
  respond @mutate 403
  @payload method GET
  @metadata {
   method GET HEAD
   expression {http.request.header.Authorization}.contains('Credential=inspect5d2274eea671/')
  }
  route @metadata {
   @heads method HEAD
   reverse_proxy @heads dpp-lifecycle307-5d2274ee-minio:9000
   @retention query retention=*
   reverse_proxy @retention dpp-lifecycle307-5d2274ee-minio:9000
   @hold query legal-hold=*
   reverse_proxy @hold dpp-lifecycle307-5d2274ee-minio:9000
   @versions {
    method GET
    path /dpp-lifecycle307-online /dpp-lifecycle307-online/ /dpp-lifecycle307-quarantine /dpp-lifecycle307-quarantine/
    query versions=*
   }
   reverse_proxy @versions dpp-lifecycle307-5d2274ee-minio:9000
   respond 403
  }
  respond 403
 }
}
