, hold release, bypass or pin release is performed.\n","labels":[],"milestone":null,"active_lock_reason":null,"created_at":"2026-10-19T12:57:30Z","updated_at":"2026-10-24T09:36:27Z","closed_at":null,"merged_at":null,"merge_commit_sha":"5e2c1bf1b9eb9cc1fcb9d5c19108866c9e4113e1","assignee":null,"assignees":[],"requested_reviewers":[],"requested_teams":[],"head":{"label":"qq550723504:codex/issue307-post-v22-dispatch-closure","ref":"codex/issue307-post-v22-dispatch-closure","repo":{"id":1372850950,"node_id":"R_kgDOUdQLBg","name":"data-product-platform","full_name":"qq550723504/data-product-platform","owner":{"login":"qq550723504","id":6007227,"node_id":"MDQ6VXNlcjYwMDcyMjc=","avatar_url":"https://avatars.githubusercontent.com/u/6007227?v=4","gravatar_id":"","url":"https://api.github.com/users/qq550723504","html_url":"https://github.com/qq550723504","followers_url":"https://api.github.com/users/qq550723504/followers","following_url":"https://api.github.com/users/qq550723504/following{/other_user}","gists_url":"https://api.github.com/users/qq550723504/gists{/gist_id}","starred_url":"https://api.github.com/users/qq550723504/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/qq550723504/subscriptions","organizations_url":"https://api.github.com/users/qq550723504/orgs","repos_url":"https://api.github.com/users/qq550723504/repos","events_url":"https://api.github.com/users/qq550723504/events{/privacy}","received_events_url":"https://api.github.com/users/qq550723504/received_events","type":"User","user_view_type":"public","site_admin":false},"private":false,"fork":false,"archived":false,"disabled":false,"description":null,"homepage":null,"language":"Go","visibility":"public","is_template":false,"topics":[],"forks_count":0,"forks":0,"stargazers_count":1,"watchers_count":1,"watchers":1,"open_issues_count":13,"open_issues":13,"size":35787,"default_branch":"main","has_issues":true,"has_projects":true,"has_wiki":true,"has_pages":false,"has_downloads":false,"ha