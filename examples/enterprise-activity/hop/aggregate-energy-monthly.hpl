<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>enterprise-activity-energy-monthly-hop</name>
    <name_sync_with_filename>N</name_sync_with_filename>
    <description>Aggregate standardized enterprise energy rows by canonical company and month.</description>
    <extended_description/>
    <pipeline_version>1.0.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>INPUT_ENERGY_STANDARDIZED_URI</name>
        <default_value/>
        <description>Core DatasetVersion storage URI for standardized energy CSV.</description>
      </parameter>
      <parameter>
        <name>OUTPUT_BASE_URI</name>
        <default_value/>
        <description>Staging object URI without extension; TextFileOutput appends .csv.</description>
      </parameter>
      <parameter>
        <name>CORE_EXECUTION_ID</name>
        <default_value/>
        <description>Core Execution identifier for traceability.</description>
      </parameter>
      <parameter>
        <name>TARGET_PERIOD</name>
        <default_value/>
        <description>Reference period supplied by Core.</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>data-product-platform</created_user>
    <created_date>2026/09/17 00:00:00.000</created_date>
    <modified_user>data-product-platform</modified_user>
    <modified_date>2026/09/17 00:00:00.000</modified_date>
    <key_for_session_key/>
    <is_key_private>N</is_key_private>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Read standardized energy</from>
      <to>Aggregate monthly energy</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Aggregate monthly energy</from>
      <to>Write monthly energy</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Read standardized energy</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${INPUT_ENERGY_STANDARDIZED_URI}</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>canonical_company_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>year_month</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal>.</decimal>
        <group>,</group>
        <length>7</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>energy_kwh</name>
        <type>Number</type>
        <format>0.############</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Aggregate monthly energy</name>
    <type>MemoryGroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <alwaysgivesbackonerow>N</alwaysgivesbackonerow>
    <group>
      <field>
        <name>canonical_company_id</name>
      </field>
      <field>
        <name>year_month</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>energy_kwh</aggregate>
        <subject>energy_kwh</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Write monthly energy</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${OUTPUT_BASE_URI}</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field>
        <name>canonical_company_id</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>both</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>year_month</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>both</trim_type>
        <length>7</length>
        <precision>-1</precision>
      </field>
      <field>
        <name>energy_kwh</name>
        <type>Number</type>
        <format>0.############</format>
        <currency/>
        <decimal>.</decimal>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling/>
  <attributes/>
</pipeline>
