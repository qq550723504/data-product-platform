{
 admin off
 auto_https off
}
:9000 {
 route {
  @unsigned header X-Amz-Content-Sha256 STREAMING-UNSIGNED-PAYLOAD-TRAILER
  respond @unsigned 403
  @bypass header X-Amz-Bypass-Governance-Retention *
  respond @bypass 403
  @copy header X-Amz-Copy-Source *
  respond @copy 403
  # Literal complete URI prohibits extra/duplicate query parameters and bare keys.
  # The native IAM policy additionally enforces s3:versionid for these two ARNs.
  @approvedDelete {
   method DELETE
   expression {http.request.header.Authorization}.contains('Credential=__DELETE_ACCESS__/') && ({http.request.uri} == '/dpp-lifecycle307-online/fixture/a.csv?versionId=cc359f61-4921-4487-852f-b6ab6d139278' || {http.request.uri} == '/dpp-lifecycle307-quarantine/fixture/b.csv?versionId=2ae6479b-2b96-441a-9159-80a07e3ec4e0')
  }
  reverse_proxy @approvedDelete minio:9000
  @mutate method DELETE PUT POST PATCH
  respond @mutate 403
  @unversioned {
   path /dpp-lifecycle307-online/fixture/* /dpp-lifecycle307-quarantine/fixture/*
   method GET HEAD
   expression {http.request.uri.query.versionId} == ''
  }
  respond @unversioned 403
  @retention {
   path /dpp-lifecycle307-online/fixture/* /dpp-lifecycle307-quarantine/fixture/*
   method GET
   query retention=*
  }
  reverse_proxy @retention minio:9000
  @legalHold {
   path /dpp-lifecycle307-online/fixture/* /dpp-lifecycle307-quarantine/fixture/*
   method GET
   query legal-hold=*
  }
  reverse_proxy @legalHold minio:9000
  @payload {
   path /dpp-lifecycle307-online/fixture/* /dpp-lifecycle307-quarantine/fixture/*
   method GET
  }
  respond @payload 403
  @health path /minio/health/ready
  reverse_proxy @health minio:9000
  @head {
   method HEAD
   path /dpp-lifecycle307-online/fixture/a.csv /dpp-lifecycle307-online/fixture/b.csv /dpp-lifecycle307-quarantine/fixture/a.csv /dpp-lifecycle307-quarantine/fixture/b.csv
  }
  reverse_proxy @head minio:9000
  @inventory {
   method GET
   path /dpp-lifecycle307-online /dpp-lifecycle307-online/ /dpp-lifecycle307-quarantine /dpp-lifecycle307-quarantine/
   query versions=*
  }
  reverse_proxy @inventory minio:9000
  respond 403
 }
}
