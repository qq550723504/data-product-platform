FROM golang:1.24-alpine AS build
WORKDIR /src/apps/platform
COPY apps/platform/go.mod apps/platform/go.sum ./
RUN go mod download
COPY apps/platform/ ./
RUN CGO_ENABLED=0 go build -o /bin-out/api ./cmd/api && \
    CGO_ENABLED=0 go build -o /bin-out/worker ./cmd/worker && \
    CGO_ENABLED=0 go build -o /bin-out/migrate ./cmd/migrate && \
    CGO_ENABLED=0 go build -o /bin-out/poc-demo ./cmd/poc-demo && \
    CGO_ENABLED=0 go build -o /bin-out/outbox-replay ./cmd/outbox-replay

FROM alpine:3.22
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 demo && mkdir /demo-state && chown demo /demo-state
WORKDIR /opt/dpp/apps/platform
COPY --from=build /bin-out/ /usr/local/bin/
COPY industry-packs/ /opt/dpp/industry-packs/
COPY examples/enterprise-activity/ /opt/dpp/examples/enterprise-activity/
COPY migrations/ /opt/dpp/migrations/
USER demo
CMD ["api"]
